SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...
# Every *_API_KEY takes a comma-separated list: quota is metered per account,
# so each extra key from another account multiplies the free daily pool.
GEMINI_API_KEY=AIza...,AIza...,AIza...
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=gsk_...,gsk_...    # optional free failover
GROQ_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b,qwen/qwen3.6-27b
OPENROUTER_API_KEY=sk-or-...    # optional second failover
# markets upgrade (2026-08-22), all optional free tiers; comma lists like the AI keys
GNEWS_API_KEY=            # gnews.io — 100 req/day
NEWSDATA_API_KEY=         # newsdata.io — 200 req/day
MARKETAUX_API_KEY=        # marketaux.com — 100 req/day, 3 articles each
FRED_API_KEY=             # fred.stlouisfed.org — macro series (phase 3)

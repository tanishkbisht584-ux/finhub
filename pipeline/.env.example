SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...
# Every *_API_KEY takes a comma-separated list: quota is metered per account,
# so each extra key from another account multiplies the free daily pool.
# (Manage all of these from the admin: Settings > Integrations.)
GEMINI_API_KEY=AIza...,AIza...,AIza...
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # optional; code default is a 6-model chain
GROQ_API_KEY=gsk_...,gsk_...    # optional free failover
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.6-27b
OPENROUTER_API_KEY=sk-or-...    # optional second failover
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_RPM_PER_LANE=15
# markets upgrade (2026-08-22), all optional free tiers; comma lists like the AI keys
GNEWS_API_KEY=            # gnews.io — 100 req/day
NEWSDATA_API_KEY=         # newsdata.io — 200 req/day
MARKETAUX_API_KEY=        # marketaux.com — 100 req/day, 3 articles each
FRED_API_KEY=             # fred.stlouisfed.org — macro series (first key only)
REDDIT_CLIENT_ID=         # reddit.com/prefs/apps 'script' app — r/ISB ticker mentions (optional)
REDDIT_CLIENT_SECRET=
TAVILY_API_KEY=           # edge qa tier-2 web search (set as an edge secret; here for the record)
# one line of JSON: pushes (alerts, watchdog, admin manual sends)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Supabase personal access token (sbp_...): admin Doctor > Schema + Integrations edge-secret sync
SUPABASE_ACCESS_TOKEN=

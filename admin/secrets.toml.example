# Copy to .streamlit/secrets.toml (gitignored). Local only: this holds the service_role key.
ADMIN_PASSWORD = "choose-a-long-password"
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_SERVICE_KEY = "<service_role key>"

# optional — all also picked up from pipeline/.env when set there
# GITHUB_TOKEN = "ghp_..."                 # Run now / Doctor dispatch; falls back to `git credential fill`
# GITHUB_REPO = "owner/repo"               # default tanishkbisht584-ux/finhub
# SUPABASE_ACCESS_TOKEN = "sbp_..."        # Doctor > Schema: apply migrations / ad-hoc SQL via Management API
# FIREBASE_SERVICE_ACCOUNT_JSON = '{...}'  # Alerts > manual send + ops pushes

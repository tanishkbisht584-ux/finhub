# Copy to .streamlit/secrets.toml (repo root). Values are in pipeline/.env.
ADMIN_PASSWORD = "choose-a-password"
SUPABASE_URL = "https://YOURPROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "eyJ...service_role_key..."
# optional — GitHub run control ("Run now", recent runs). Falls back to
# `git credential fill` when unset. Needs the `workflow` scope.
# GITHUB_TOKEN = "ghp_..."
GITHUB_REPO = "tanishkbisht584-ux/finhub"
# optional — manual alert sends / ops test push from the Alerts page
# FIREBASE_SERVICE_ACCOUNT_JSON = '{"type":"service_account", ...}'
